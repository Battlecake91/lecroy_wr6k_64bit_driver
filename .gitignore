# Ghidra local/transient project database artifacts
# Keep the project, but ignore rotating database snapshots and lock files.
ghidra_reverse_engineering_lecroy/**/*.lock
ghidra_reverse_engineering_lecroy/**/*.lock~
ghidra_reverse_engineering_lecroy/**/~*.db/
ghidra_reverse_engineering_lecroy/**/tmp*.ps

# Local Ghidra installation path
.ghidra-local.ps1

# All raw startup traces may contain unique ROM IDs and private licensing data.
# Keep old unredacted captures out of the public repository.
trace-captures/
lecwatch_session*.jsonl
lecwatch_action_summary*.md


# Local build outputs and generated driver packages
x64/
tools/lecdiag/build/
tools/lecwatch/build/

# Native, hardware-independent unit test output
tests/dry/build/

# Visual Studio / package-manager caches
.vs/
packages/

# Per-user Visual Studio project state
*.vcxproj.user

# Local compiler object files
*.obj

# Private PCI-card DS2433 backups may contain XStream license keys.
license-backups/
*.ds2433.bin

# Private LeCroy FPGA firmware/schematic evidence used only for offline analysis.
private_evidence/
BINARY_*.bin
BINARY_*.mcs
WR6k_PCI_FPGA_Handoff_*/

xstream-automation-dump*.txt
